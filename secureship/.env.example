# Auth0 credentials — create an application at https://manage.auth0.com
# Application type: Single Page Application
# Allowed Callback URLs: http://localhost:3000/admin
# Allowed Logout URLs: http://localhost:3000
# Allowed Web Origins: http://localhost:3000

# Your Auth0 tenant domain (e.g. dev-abc123.us.auth0.com)
AUTH0_DOMAIN=

# Client ID from the Auth0 application settings
AUTH0_CLIENT_ID=

# API Audience — create an Auth0 API and set its Identifier here
# (e.g. https://secureship-api)
AUTH0_AUDIENCE=
